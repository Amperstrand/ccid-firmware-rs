# Boot-smoke build image — pinned esp toolchain, mirrors ci.yml's esp legs.
# Pure toolchain image: NO repo sources (they are bind-mounted at run time).
# Pins mirror .github/workflows/ci.yml's esp32 build legs:
#   - esp toolchain via espup, pinned exactly as ci.yml's esp legs
#     (espup crate unpinned; toolchain -v 1.98.1.0, crosstool
#     -c 14.2.0_20260121, targets esp32,esp32c3)
#   - ldproxy via cargo install (unpinned, same as ci.yml)
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git curl ca-certificates python3 python3-pip python3-venv \
        pkg-config libudev-dev libssl-dev \
        cmake ninja-build ninja-build file wget unzip \
    && rm -rf /var/lib/apt/lists/*

# Rust (rustup default profile) then the pinned esp toolchain via espup.
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

# The trailing `|| true` on the old single chain silently swallowed a
# FAILED espup install too: the image built "fine" without
# /root/export-esp.sh and every boot-smoke build leg died at
# build-in-container.sh:26 (found by the #520 forced-red first live
# run). Critical toolchain chain is now unmasked; only the genuinely
# optional cargo-generate keeps its fallback.
# 1.98.1.0 is the TOOLCHAIN version (espup install -v), NOT a valid
# cargo-install crate version — the old --version pin failed cargo's
# semver parse instantly; combined with the masked chain the image
# ALWAYS built without a toolchain (second bug found by the #520 demo).
RUN cargo install espup \
    && espup install -c 14.2.0_20260121 -v 1.98.1.0 --targets esp32,esp32c3 \
    && cargo install ldproxy
RUN cargo install cargo-generate --locked || true

# Warm mounts used by the workflow's docker run: caches cross container
# lifetimes while the throwaway container stays disposable.
ENV CARGO_HOME=/work/cargo-registry
ENV IDF_TOOLS_PATH=/work/espressif
RUN mkdir -p /work/cargo-registry /work/espressif /out

# build-in-container.sh is executed from the bind-mounted /src checkout.
WORKDIR /src
CMD ["bash", "/src/tools/boot-smoke/build-in-container.sh"]
