diff --git a/virtualsmartcard/src/vpcd/vpcd.c b/virtualsmartcard/src/vpcd/vpcd.c
index 371daa3..e04c7c1 100644
--- a/virtualsmartcard/src/vpcd/vpcd.c
+++ b/virtualsmartcard/src/vpcd/vpcd.c
@@ -58,6 +58,11 @@ typedef WORD uint16_t;
 static ssize_t sendToVICC(struct vicc_ctx *ctx, size_t size, const unsigned char *buffer);
 static ssize_t recvFromVICC(struct vicc_ctx *ctx, unsigned char **buffer);
 
+/* AMPERSTRAND FIX (#326): receive timeout for vpicc sockets, seconds */
+#ifndef VPCD_RECV_TIMEOUT_SEC
+#define VPCD_RECV_TIMEOUT_SEC 2
+#endif
+
 static ssize_t sendall(SOCKET sock, const void *buffer, size_t size);
 static ssize_t recvall(SOCKET sock, void *buffer, size_t size);
 
@@ -267,6 +272,19 @@ static ssize_t recvFromVICC(struct vicc_ctx *ctx, unsigned char **buffer)
 
     /* receive size of message on 2 bytes */
     r = recvall(ctx->client_sock, &size, sizeof size);
+    if (r == 0) {
+        /* AMPERSTRAND FIX (EOF-eject): a 0-byte size read is the peer
+         * CLOSING (EOF), not a zero-length answer — a zero-length answer
+         * is a COMPLETE 2-byte 0x0000 frame. Converting EOF to -1 makes
+         * vicc_transmit eject the dead socket immediately, so the next
+         * accept can happen; without this a departed vpicc can wedge the
+         * single-peer slot: recv()==0 reads as "absent" (never an error),
+         * and once pcscd's EH stops probing a slot it marked dead no
+         * further send ever fires the EPIPE eject path (observed twice on
+         * the bench 2026-10-30: CLOSE-WAIT until a pcscd restart). */
+        errno = ECONNRESET;
+        return -1;
+    }
     if (r < sizeof size)
         return r;
 
@@ -383,7 +401,9 @@ ssize_t vicc_transmit(struct vicc_ctx *ctx,
         unlock(ctx->io_lock);
     }
 
-    if (r <= 0)
+    /* AMPERSTRAND FIX (#326): eject on hard transport errors only.
+     * r == 0 is a valid zero-length answer (see recvFromVICC). */
+    if (r < 0)
         vicc_eject(ctx);
 
     return r;
@@ -408,8 +428,21 @@ int vicc_connect(struct vicc_ctx *ctx, long secs, long usecs)
     if (ctx->client_sock == INVALID_SOCKET)
         /* not connected */
         return 0;
-    else
-        return 1;
+
+    /* AMPERSTRAND FIX (#326, part 2): bound every blocking receive on
+     * the vpicc socket.  Without this, one unanswered probe (vpicc
+     * rebooting mid-conversation, firmware serve loop stalled) wedges
+     * pcscd's EH thread in recv() forever — and because the listener
+     * runs with backlog 0, every future vpicc connection attempt is
+     * then dropped too: a permanent wedge until pcscd restarts. */
+    {
+        struct timeval tv;
+        tv.tv_sec  = VPCD_RECV_TIMEOUT_SEC;
+        tv.tv_usec = 0;
+        setsockopt(ctx->client_sock, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv);
+    }
+
+    return 1;
 }
 
 int vicc_present(struct vicc_ctx *ctx) {
