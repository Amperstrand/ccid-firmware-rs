diff --git i/firmware/esp32-ccid/.cargo/config.toml w/firmware/esp32-ccid/.cargo/config.toml
index c5f6cfa..d52dbc1 100644
--- i/firmware/esp32-ccid/.cargo/config.toml
+++ w/firmware/esp32-ccid/.cargo/config.toml
@@ -6,6 +6,16 @@ linker = "ldproxy"
 runner = "espflash flash --monitor"
 rustflags = ["--cfg", "espidf_time64", "-Zunstable-options", "-C", "panic=immediate-abort"]
 
+# ESP32-C3 (RISC-V RV32IMC). riscv32imc-esp-espidf is Tier-3 with the toolchain in
+# use, so std is provided via -Z build-std below (same as the xtensa target).
+# Build with: cargo build --target riscv32imc-esp-espidf
+# (panic=immediate-abort is Xtensa-only in this repo; RISC-V uses the default
+# panic_abort selected by build-std.)
+[target.riscv32imc-esp-espidf]
+linker = "ldproxy"
+runner = "espflash flash --monitor"
+rustflags = ["--cfg", "espidf_time64", "-Zunstable-options"]
+
 [unstable]
 build-std = ["std", "panic_abort"]
 
